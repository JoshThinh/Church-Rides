# Copy this file to `.env.local` and fill in the values from
# Supabase → Project Settings → API.
# Leave them blank to run in DEMO MODE (data saved only in your browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The admin "username" is turned into this email behind the scenes.
# Username "admin" + domain "lbcrides.app" → admin@lbcrides.app
VITE_ADMIN_EMAIL_DOMAIN=lbcrides.app
